{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bewater.local/contracts/release-config.schema.json",
  "x-bewater-version": "4.0.0",
  "title": "BeWater Release Config",
  "type": "object",
  "required": ["version", "release_boundary", "adapters"],
  "properties": {
    "version": {"const": 1},
    "release_boundary": {"enum": ["local", "git_remote", "script"]},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["local", "git_push", "script"]},
          "enabled": {"type": "boolean"},
          "actions": {
            "type": "array",
            "items": {"enum": ["release_record", "commit", "tag"]}
          },
          "tag_template": {"type": "string"},
          "remote": {"type": "string"},
          "branch": {"type": "string"},
          "push_tags": {"type": "boolean"},
          "command": {"type": "string"},
          "requires_irreversible_ack": {"type": "boolean"},
          "expected_evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
