{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bewater.local/contracts/methodology-backlog.schema.json",
  "x-bewater-version": "4.0.0",
  "title": "BeWater Methodology Backlog",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "string" },
    "template": { "type": "string" },
    "allowed_statuses": {
      "type": "array",
      "items": { "enum": ["open", "accepted", "rejected", "planned", "done"] }
    },
    "item_shape": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "source",
          "target_file",
          "problem",
          "proposed_change",
          "status",
          "owner",
          "decision",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["must", "should", "could"] },
          "source": { "type": "string" },
          "target_file": { "type": "string" },
          "evidence": { "type": "string" },
          "problem": { "type": "string" },
          "proposed_change": { "type": "string" },
          "status": { "enum": ["open", "accepted", "rejected", "planned", "done"] },
          "owner": { "type": "string" },
          "decision": { "type": "string" },
          "updated_at": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

