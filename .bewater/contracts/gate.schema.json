{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bewater.local/contracts/gate.schema.json",
  "x-bewater-version": "4.0.0",
  "title": "BeWater Gate",
  "type": "object",
  "required": [
    "status",
    "freshness",
    "concerns",
    "blockers",
    "evaluated_at",
    "input_digest",
    "produced_by",
    "evidence_refs"
  ],
  "properties": {
    "status": {
      "enum": ["pending", "passed", "failed", "blocked", "go", "no-go"]
    },
    "freshness": {
      "type": "object",
      "required": ["status", "checked_at", "stale_reasons"],
      "properties": {
        "status": { "enum": ["unknown", "fresh", "stale"] },
        "checked_at": { "type": ["string", "null"] },
        "stale_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "concerns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluated_at": { "type": ["string", "null"] },
    "evaluated_commit_sha": { "type": ["string", "null"] },
    "input_digest": { "type": "string" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "produced_by": { "type": ["string", "null"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updated_at": { "type": ["string", "null"] },
    "evidence_checked": { "type": "boolean" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "not": { "const": "pending" } }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "produced_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
